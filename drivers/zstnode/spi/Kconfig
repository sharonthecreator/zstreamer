config ZSTNODE_SPI_SRC
	bool "SPI source zstnode driver"
	default y
	depends on DT_HAS_ZSTREAMER_ZSTSRC_SPI_ENABLED
	depends on ZSTNODE
	depends on SPI
	help
	  Enable the SPI source streaming node driver.
	  Reads bytes from an SPI device (as master) and submits them
	  as buffers into the streaming graph.

config ZSTNODE_SPI_SINK
	bool "SPI sink zstnode driver"
	default y
	depends on DT_HAS_ZSTREAMER_ZSTSINK_SPI_ENABLED
	depends on ZSTNODE
	depends on SPI
	help
	  Enable the SPI sink streaming node driver.
	  Writes received buffer data to an SPI device (as master).

config ZSTNODE_SPI_DMA_RX_BUF_SIZE
	int "SPI DMA RX buffer size"
	default 256
	depends on SPI_ASYNC
	depends on ZSTNODE_SPI_SRC
	help
	  Size in bytes of the intermediate receive buffer used for
	  async SPI reads. Only used when SPI_ASYNC is available.
