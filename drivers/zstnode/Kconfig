menuconfig ZSTNODE
	bool "zstnode driver support"
	depends on ZSTREAMER
	help
	  Enable zstnode driver subsystem. zstnode is the driver type
	  for streaming nodes in the zstreamer framework.

if ZSTNODE

module = ZSTNODE
module-str = zstnode
source "subsys/logging/Kconfig.template.log_config"

endif # ZSTNODE
