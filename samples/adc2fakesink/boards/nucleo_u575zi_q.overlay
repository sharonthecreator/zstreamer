 *
 * ADC-to-FakeSink sample on Nucleo U575ZI-Q.
 *
 * Captures dual-channel 12-bit ADC data from PA0 (ADC1_IN0) and
 * PA1 (ADC1_IN1) at ~1 kHz using Zephyr's portable ADC API.
 */

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/ {
	streaming_graph: streaming-graph {
		compatible = "zstreamer,graph";
		buffer-count = <8>;
		buffer-size = <512>;

		adc_source: adc-source {
			compatible = "zstreamer,adc-src";
			io-channels = <&adc1 0>, <&adc1 1>;
			sample-rate-hz = <1000>;
			samples = <64>;
			children = <&fake_sinker>;
			autostart;
			thread-stack-size = <2048>;
		};

		fake_sinker: fake-sinker {
			compatible = "zstreamer,fake-sink";
		};
	};
};
