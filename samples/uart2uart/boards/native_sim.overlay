 *
 * UART-to-UART relay on native_sim using emulated UARTs.
 */

/ {
	uart_src: uart-emul-src {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <256>;
		tx-fifo-size = <256>;
		status = "okay";
	};

	uart_sink: uart-emul-sink {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <256>;
		tx-fifo-size = <256>;
		status = "okay";
	};

	streaming_graph: streaming-graph {
		compatible = "zstreamer,graph";
		#address-cells = <1>;
		#size-cells = <0>;
		buf-num = <8>;
		buffer-size = <128>;

		uart_source: uart-source@0 {
			compatible = "zstreamer,zstsrc-uart";
			reg = <0>;
			uart-device = <&uart_src>;
			children = <&uart_sinker>;
		};

		uart_sinker: uart-sinker@1 {
			compatible = "zstreamer,zstsink-uart";
			reg = <1>;
			uart-device = <&uart_sink>;
		};
	};
};
