/ {
	uart_src: uart-emul-src {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <32768>;
		tx-fifo-size = <32768>;
		status = "okay";
	};

	uart_sink: uart-emul-sink {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <32768>;
		tx-fifo-size = <32768>;
		status = "okay";
	};

	streaming_graph: streaming-graph {
		compatible = "zstreamer,graph";
		buffer-count = <8>;
		buffer-size = <1024>;

		uart_source: uart-source {
			compatible = "zstreamer,src-uart";
			uart-device = <&uart_src>;
			children = <&uart_sinker>;
			thread-stack-size = <1024>;
			thread-priority = <5>;
		};

		uart_sinker: uart-sinker {
			compatible = "zstreamer,sink-uart";
			uart-device = <&uart_sink>;
			thread-stack-size = <1024>;
			thread-priority = <5>;
		};

		numgen_source: numgen-source {
			compatible = "zstreamer,src-numgen";
			children = <&fake_sinker>;
			thread-stack-size = <1024>;
			thread-priority = <5>;
		};

		fake_sinker: fake-sinker {
			compatible = "zstreamer,sink-fake";
			thread-stack-size = <1024>;
			thread-priority = <5>;
		};
	};
};
