#include <dt-bindings/adc/adc.h>

/ {
	adc_emul: adc-emul {
		compatible = "zephyr,adc-emul";
		nchannels = <2>;
		ref-vdd-mv = <3300>;
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		channel@0 {
			reg = <0>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_VDD_1";
			zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
			zephyr,resolution = <12>;
		};

		channel@1 {
			reg = <1>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_VDD_1";
			zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
			zephyr,resolution = <8>;
		};
	};

	adc_streaming_graph: adc-streaming-graph {
		compatible = "zstreamer,graph";
		buffer-count = <8>;
		buffer-size = <128>;

		/* 12-bit source */
		adc_source: adc-source {
			compatible = "zstreamer,adc-src";
			io-channels = <&adc_emul 0>;
			sample-rate-hz = <1000>;
			samples = <16>;
			children = <&counter>;
		};

		/* 8-bit source */
		adc_source_8bit: adc-source-8bit {
			compatible = "zstreamer,adc-src";
			io-channels = <&adc_emul 1>;
			sample-rate-hz = <1000>;
			samples = <16>;
			children = <&counter>;
		};

		counter: counter-sink {
			compatible = "zstreamer,count-sink";
		};
	};
};
